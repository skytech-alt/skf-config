// ============================================
//   skf-config — управление конфигами
//   от SkyMonder
// ============================================

// Подтягиваем пакеты-помощники
пусть файлы = подтянуть "skf-files"
пусть json = подтянуть "skf-json"


// --------------------------------------------
//   СОЗДАНИЕ И ЗАГРУЗКА
// --------------------------------------------

функция создать(путь, значения_по_умолчанию) {
    // Создаёт объект-конфиг, привязанный к файлу.
    // Если файл существует — загружает его.
    // Если нет — создаёт с значениями по умолчанию.
    если (значения_по_умолчанию == ничего) {
        значения_по_умолчанию = {}
    }
    
    пусть конфиг = {
        "путь": путь,
        "данные": значения_по_умолчанию,
        "умолчания": значения_по_умолчанию,
        "формат": "json"
    }
    
    если (файлы.существует?(путь)) {
        попробовать {
            конфиг["данные"] = json.читать(путь)
        } поймать (ошибка) {
            // Не удалось прочитать — оставляем умолчания
        }
    } иначе {
        // Файла нет — создаём с умолчаниями
        попробовать {
            json.записать_красиво(путь, значения_по_умолчанию)
        } поймать (ошибка) {
            // Не удалось записать — не критично
        }
    }
    
    вернуть конфиг
}

функция загрузить(путь) {
    // Загружает конфиг из файла (без умолчаний).
    если (файлы.существует?(путь) == ложь) {
        бросить "Файл конфига не найден: " + путь
    }
    
    пусть конфиг = {
        "путь": путь,
        "данные": json.читать(путь),
        "умолчания": {},
        "формат": "json"
    }
    
    вернуть конфиг
}


// --------------------------------------------
//   СОХРАНЕНИЕ
// --------------------------------------------

функция сохранить(конфиг) {
    // Сохраняет конфиг в файл.
    попробовать {
        json.записать_красиво(конфиг["путь"], конфиг["данные"])
        вернуть истина
    } поймать (ошибка) {
        бросить "Не удалось сохранить конфиг: " + ошибка
    }
}

функция перезагрузить(конфиг) {
    // Перечитывает конфиг из файла.
    если (файлы.существует?(конфиг["путь"])) {
        конфиг["данные"] = json.читать(конфиг["путь"])
    }
    вернуть конфиг
}

функция сбросить(конфиг) {
    // Сбрасывает конфиг к значениям по умолчанию и сохраняет.
    конфиг["данные"] = json.копия(конфиг["умолчания"])
    сохранить(конфиг)
    вернуть конфиг
}


// --------------------------------------------
//   ПОЛУЧЕНИЕ ЗНАЧЕНИЙ
// --------------------------------------------

функция получить(конфиг, путь, по_умолчанию) {
    // Получает значение по пути в стиле dot-notation.
    // Пример: получить(конфиг, "окно.ширина")
    пусть значение = json.получить(конфиг["данные"], путь)
    
    если (значение == ничего) {
        // Пробуем взять из умолчаний
        пусть из_умолчаний = json.получить(конфиг["умолчания"], путь)
        если (из_умолчаний != ничего) {
            вернуть из_умолчаний
        }
        вернуть по_умолчанию
    }
    
    вернуть значение
}

функция есть?(конфиг, путь) {
    // Проверяет, существует ли путь в конфиге.
    вернуть json.существует_путь?(конфиг["данные"], путь)
}

функция все(конфиг) {
    // Возвращает весь словарь конфига.
    вернуть конфиг["данные"]
}

функция ключи_конфига(конфиг) {
    // Возвращает список ключей верхнего уровня.
    вернуть json.ключи(конфиг["данные"])
}


// --------------------------------------------
//   УСТАНОВКА ЗНАЧЕНИЙ
// --------------------------------------------

функция установить(конфиг, путь, значение, автосохранение) {
    // Устанавливает значение по пути.
    // Если автосохранение = истина, сразу сохраняет в файл.
    json.установить(конфиг["данные"], путь, значение)
    
    если (автосохранение == истина) {
        сохранить(конфиг)
    }
    
    вернуть конфиг
}

функция установить_несколько(конфиг, пары, автосохранение) {
    // Устанавливает несколько значений сразу.
    // пары — словарь {"путь": значение, ...}.
    для (путь, значение в пары.предметы()) {
        json.установить(конфиг["данные"], путь, значение)
    }
    
    если (автосохранение == истина) {
        сохранить(конфиг)
    }
    
    вернуть конфиг
}

функция удалить(конфиг, путь, автосохранение) {
    // Удаляет значение по пути.
    json.удалить_путь(конфиг["данные"], путь)
    
    если (автосохранение == истина) {
        сохранить(конфиг)
    }
    
    вернуть конфиг
}

функция объединить(конфиг, новые_данные, автосохранение) {
    // Глубоко сливает новые данные с текущими.
    конфиг["данные"] = json.слить_глубоко(конфиг["данные"], новые_данные)
    
    если (автосохранение == истина) {
        сохранить(конфиг)
    }
    
    вернуть конфиг
}


// --------------------------------------------
//   УМОЛЧАНИЯ
// --------------------------------------------

функция установить_умолчания(конфиг, умолчания) {
    // Устанавливает значения по умолчанию.
    // Они используются, если ключ отсутствует в основном конфиге.
    конфиг["умолчания"] = умолчания
    вернуть конфиг
}

функция добавить_умолчание(конфиг, путь, значение) {
    // Добавляет одно значение по умолчанию.
    json.установить(конфиг["умолчания"], путь, значение)
    вернуть конфиг
}

функция заполнить_пропуски(конфиг, автосохранение) {
    // Заполняет конфиг всеми умолчаниями, которых в нём нет.
    пусть заполненный = json.слить_глубоко(конфиг["умолчания"], конфиг["данные"])
    конфиг["данные"] = заполненный
    
    если (автосохранение == истина) {
        сохранить(конфиг)
    }
    
    вернуть конфиг
}


// --------------------------------------------
//   INI-ФОРМАТ (простой)
// --------------------------------------------

функция читать_ini(путь) {
    // Читает простой INI-файл (секции в квадратных скобках, ключ = значение).
    // Возвращает вложенный словарь: {"секция": {"ключ": "значение"}}.
    если (файлы.существует?(путь) == ложь) {
        бросить "INI-файл не найден: " + путь
    }
    
    пусть строки = файлы.прочитать_строки(путь)
    пусть результат = {}
    пусть текущая_секция = "общее"
    
    для (строка в строки) {
        пусть очищенная = строка.обрезать()
        
        // Пропускаем пустые и комментарии
        если (длина(очищенная) == 0) {
            продолжить
        }
        если (очищенная.начинается_с("#") или очищенная.начинается_с(";")) {
            продолжить
        }
        
        // Секция [имя]
        если (очищенная.начинается_с("[") и очищенная.заканчивается_на("]")) {
            текущая_секция = очищенная[1 : длина(очищенная) - 1]
            если (результат.содержит(текущая_секция) == ложь) {
                результат[текущая_секция] = {}
            }
            продолжить
        }
        
        // Ключ = значение
        пусть позиция = очищенная.найти("=")
        если (позиция == -1) {
            продолжить
        }
        
        пусть ключ = очищенная[0 : позиция].обрезать()
        пусть значение = очищенная[позиция + 1 : ].обрезать()
        
        // Убираем кавычки, если есть
        если (значение.начинается_с('"') и значение.заканчивается_на('"')) {
            значение = значение[1 : длина(значение) - 1]
        }
        
        // Преобразуем типы
        если (значение == "истина" или значение == "true") {
            значение = истина
        } иначе если (значение == "ложь" или значение == "false") {
            значение = ложь
        } иначе {
            попробовать {
                значение = число(значение)
            } поймать (ошибка) {
                // Оставляем как строку
            }
        }
        
        если (результат.содержит(текущая_секция) == ложь) {
            результат[текущая_секция] = {}
        }
        результат[текущая_секция][ключ] = значение
    }
    
    вернуть результат
}

функция записать_ini(путь, данные) {
    // Записывает словарь в INI-файл.
    пусть строки = []
    
    для (секция, содержимое в данные.предметы()) {
        строки.добавить("[" + секция + "]")
        
        если (тип(содержимое) == "словарь") {
            для (ключ, значение в содержимое.предметы()) {
                строки.добавить(ключ + " = " + _в_строку(значение))
            }
        } иначе {
            строки.добавить(секция + " = " + _в_строку(содержимое))
        }
        
        строки.добавить("")
    }
    
    файлы.записать_файл(путь, строки.соединить("\n"))
    вернуть истина
}

функция _в_строку(значение) {
    // Внутренняя: преобразует значение в строку для INI.
    если (тип(значение) == "строка") {
        вернуть значение
    }
    если (значение == истина) {
        вернуть "истина"
    }
    если (значение == ложь) {
        вернуть "ложь"
    }
    вернуть строка(значение)
}

функция создать_ini(путь, умолчания) {
    // Аналог создать(), но для INI-файла.
    если (умолчания == ничего) {
        умолчания = {}
    }
    
    пусть конфиг = {
        "путь": путь,
        "данные": умолчания,
        "умолчания": умолчания,
        "формат": "ini"
    }
    
    если (файлы.существует?(путь)) {
        попробовать {
            конфиг["данные"] = читать_ini(путь)
        } поймать (ошибка) {
            // Оставляем умолчания
        }
    } иначе {
        записать_ini(путь, умолчания)
    }
    
    вернуть конфиг
}

функция сохранить_ini(конфиг) {
    // Сохраняет INI-конфиг.
    записать_ini(конфиг["путь"], конфиг["данные"])
    вернуть истина
}


// --------------------------------------------
//   УТИЛИТЫ
// --------------------------------------------

функция существует?(путь_к_файлу) {
    // Проверяет, существует ли файл конфига.
    вернуть файлы.существует?(путь_к_файлу)
}

функция удалить_конфиг(путь_к_файлу) {
    // Удаляет файл конфига.
    если (файлы.существует?(путь_к_файлу)) {
        файлы.удалить_файл(путь_к_файлу)
        вернуть истина
    }
    вернуть ложь
}

функция размер_конфига(конфиг) {
    // Количество ключей во всём дереве.
    вернуть json.количество_ключей(конфиг["данные"])
}

функция копия_конфига(конфиг) {
    // Создаёт глубокую копию конфига.
    вернуть {
        "путь": конфиг["путь"],
        "данные": json.копия(конфиг["данные"]),
        "умолчания": json.копия(конфиг["умолчания"]),
        "формат": конфиг["формат"]
    }
}

функция сравнить_конфиги(конфиг1, конфиг2) {
    // Возвращает различия между двумя конфигами.
    вернуть json.различия(конфиг1["данные"], конфиг2["данные"])
}
